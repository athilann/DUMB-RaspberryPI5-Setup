# DUMB Environment Variables — COPY THIS FILE TO .env AND FILL IN VALUES
# The .env file is gitignored. NEVER commit .env or paste real values here.

# Real-Debrid API token
# Get from: https://real-debrid.com/apitoken
RD_API_TOKEN=

# Plex server claim token (expires 4 minutes after generation)
# Get from: https://plex.tv/claim — run 04-configure-env.sh immediately after
PLEX_CLAIM=

# Plex authentication token (permanent, different from PLEX_CLAIM)
# Used by Radarr/Sonarr for Plex Watchlist import
# How to find: In Plex Web → Account → Plex Token, or visit:
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=

# Timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# User/group IDs for file permissions (run `id` on the Pi to check)
PUID=1000
PGID=1000
